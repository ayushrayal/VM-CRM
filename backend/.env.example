# ==============================================================
# Vytalis Media CRM - Backend Environment Template (Render)
# DO NOT COMMIT REAL CREDENTIALS TO GIT.
# ==============================================================

# Server Environment (production | development | test)
NODE_ENV=production

# Server Port (Render sets this automatically in production)
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=

# Frontend Application Origin (for CORS and credentials)
# Supports a single URL or comma-separated origins (no trailing slash)
# Example: https://your-frontend.onrender.com
CLIENT_URL=

# JWT Authentication Secret (minimum 16 characters)
JWT_SECRET=

# JWT Token Expiration (e.g. 1d, 7d, 24h)
JWT_EXPIRES_IN=1d

# Admin Registration Access Key (minimum 8 characters)
ADMIN_ACCESS_KEY=

# Redis Connection URL (optional - memory rate limiter used as fallback)
# Example: redis://default:<password>@<host>:<port>
REDIS_URL=

# Custom DNS (optional - set to 'false' to disable custom DNS override in local dev)
USE_CUSTOM_DNS=false